{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotifyHub",
  "version": "1.0.0",
  "identifier": "edu.notifyhub.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotifyHub",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Campus notification system",
    "longDescription": "Desktop client for NotifyHub, a PostgreSQL-backed campus notification system."
  }
}
